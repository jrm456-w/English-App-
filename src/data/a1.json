      "title": "Colors / Colores",
      "vocabulary": [
        { "en": "Red", "es": "Rojo" },
        { "en": "Blue", "es": "Azul" },
        { "en": "Green", "es": "Verde" },
        { "en": "Yellow", "es": "Amarillo" },
        { "en": "Black", "es": "Negro" },
        { "en": "White", "es": "Blanco" },
        { "en": "Orange", "es": "Naranja" },
        { "en": "Purple", "es": "Morado" },
        { "en": "Pink", "es": "Rosa" },
        { "en": "Brown", "es": "Marrón" },
        { "en": "Gray", "es": "Gris" }
      ],
      "grammar": {
        "rule": "Adjectives before nouns",
        "explanation_es": "En inglés el adjetivo va antes del sustantivo: 'a red car' (un coche rojo), no 'a car red'.",
        "examples": ["The car is red.", "I have a blue pen.", "She likes green apples.", "It is a yellow flower.", "He has a black dog."]
      },
      "games": ["word_match", "fill_blank", "flashcard"]
    },
