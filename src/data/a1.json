      },
      "games": ["word_match", "fill_blank", "flashcard"]
    },
    {
      "id": "u6",
      "title": "Common Verbs / Verbos comunes",
      "vocabulary": [
        { "en": "To be", "es": "Ser / Estar" },
        { "en": "To have", "es": "Tener" },
        { "en": "To do", "es": "Hacer" },
        { "en": "To go", "es": "Ir" },
        { "en": "To eat", "es": "Comer" },
        { "en": "To drink", "es": "Beber" },
        { "en": "To want", "es": "Querer" },
        { "en": "To like", "es": "Gustar" },
        { "en": "To live", "es": "Vivir" },
        { "en": "To speak", "es": "Hablar" },
        { "en": "To work", "es": "Trabajar" },
        { "en": "To see", "es": "Ver" }
      ],
      "grammar": {
        "rule": "Present Simple – I/You/We/They",
        "explanation_es": "En presente simple, con I/you/we/they usamos el verbo base: 'I eat', 'they live'.",
        "examples": ["I eat breakfast.", "They live in Madrid.", "We like music.", "You speak English.", "I work every day."]
      },
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo"]
    },
    {
