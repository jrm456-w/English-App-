{
  "level": "A1",
  "units": [
    {
      "id": "u1",
      "title": "Greetings / Saludos",
      "vocabulary": [
        { "en": "Hello", "es": "Hola" },
        { "en": "Goodbye", "es": "Adiós" },
        { "en": "Good morning", "es": "Buenos días" },
        { "en": "Good afternoon", "es": "Buenas tardes" },
        { "en": "Good night", "es": "Buenas noches" },
        { "en": "Please", "es": "Por favor" },
        { "en": "Thank you", "es": "Gracias" },
        { "en": "You're welcome", "es": "De nada" },
        { "en": "Excuse me", "es": "Disculpe" },
        { "en": "Sorry", "es": "Lo siento" },
        { "en": "Yes", "es": "Sí" },
        { "en": "No", "es": "No" }
      ],
      "grammar": {
        "rule": "Verb TO BE – Affirmative",
        "explanation_es": "El verbo 'to be' (ser/estar) cambia según el sujeto: I am, you are, he/she/it is, we/they are.",
        "examples": ["I am a student.", "She is happy.", "We are friends.", "You are welcome.", "He is my brother."]
      },
      "fill": [
        { "sentence": "I ___ a student.", "answer": "am", "options": ["is", "are", "be"] },
        { "sentence": "She ___ happy.", "answer": "is", "options": ["am", "are", "be"] },
        { "sentence": "We ___ friends.", "answer": "are", "options": ["am", "is", "be"] }
      ],
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo"]
    },
    {
      "id": "u2",
      "title": "Pronouns / Pronombres",
      "vocabulary": [
        { "en": "I", "es": "Yo" },
        { "en": "You", "es": "Tú / Usted" },
        { "en": "He", "es": "Él" },
        { "en": "She", "es": "Ella" },
        { "en": "It", "es": "Ello (cosa/animal)" },
        { "en": "We", "es": "Nosotros" },
        { "en": "They", "es": "Ellos" },
        { "en": "My", "es": "Mi" },
        { "en": "Your", "es": "Tu" },
        { "en": "His", "es": "Su (de él)" },
        { "en": "Her", "es": "Su (de ella)" },
        { "en": "Our", "es": "Nuestro" }
      ],
      "grammar": {
        "rule": "Subject pronouns + TO BE",
        "explanation_es": "Cada pronombre usa una forma de 'to be': I am, you are, he/she/it is, we/they are.",
        "examples": ["I am here.", "You are my friend.", "He is tall.", "It is a cat.", "They are at home."]
      },
      "games": ["word_match", "fill_blank", "flashcard"]
    },
    {
