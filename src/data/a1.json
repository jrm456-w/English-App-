        { "en": "Water", "es": "Agua" },
        { "en": "Window", "es": "Ventana" }
      ],
      "grammar": {
        "rule": "Articles a / an / the",
        "explanation_es": "Usamos 'a' antes de consonante, 'an' antes de vocal, y 'the' para algo específico.",
        "examples": ["a book", "an apple", "the house", "I have a car.", "Open the door."]
      },
      "games": ["word_match", "fill_blank", "flashcard"]
    },
    {
