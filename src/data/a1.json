      "grammar": {
        "rule": "Prepositions of time: on / in / at",
        "explanation_es": "Usamos 'on' con días (on Monday), 'in' con meses/años (in May), 'at' con horas (at 5).",
        "examples": ["I work on Monday.", "See you tomorrow.", "The class is at three.", "We meet on Friday.", "It is in May."]
      },
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo"]
    },
