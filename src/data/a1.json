        { "en": "Salt", "es": "Sal" },
        { "en": "Food", "es": "Comida" }
      ],
      "grammar": {
        "rule": "I like / I want",
        "explanation_es": "Para expresar gustos y deseos: 'I like coffee' (me gusta el café), 'I want water' (quiero agua).",
        "examples": ["I like apples.", "I want some bread.", "She likes tea.", "We want coffee.", "Do you like rice?"]
      },
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo"]
    }
  ]
