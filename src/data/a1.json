        { "en": "Next to", "es": "Al lado de" },
        { "en": "Near", "es": "Cerca" }
      ],
      "grammar": {
        "rule": "Prepositions of place",
        "explanation_es": "Indican dónde está algo: in (en), on (sobre), under (debajo), next to (al lado de).",
        "examples": ["The cat is under the table.", "The book is on the chair.", "I live near the park.", "The store is next to the school.", "She is in the city."]
      },
      "games": ["word_match", "fill_blank", "flashcard"]
    },
    {
      "id": "u10",
      "title": "Food Basics / Comida básica",
      "vocabulary": [
        { "en": "Bread", "es": "Pan" },
        { "en": "Milk", "es": "Leche" },
        { "en": "Egg", "es": "Huevo" },
        { "en": "Apple", "es": "Manzana" },
        { "en": "Rice", "es": "Arroz" },
        { "en": "Chicken", "es": "Pollo" },
        { "en": "Coffee", "es": "Café" },
