        { "en": "Breakfast", "es": "Desayuno" },
        { "en": "Dessert", "es": "Postre" },
        { "en": "Hungry", "es": "Hambriento" },
        { "en": "Thirsty", "es": "Sediento" }
      ],
      "grammar": {
        "rule": "Countable & Uncountable (some/any)",
        "explanation_es": "Usamos 'some' en afirmativas y 'any' en negativas/preguntas: 'I have some bread', 'I don't have any milk'.",
        "examples": ["I have some cheese.", "There isn't any juice.", "Do you want some soup?", "We need some vegetables.", "I am very hungry."]
      },
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo"]
    },
    {
      "id": "u3",
      "title": "Jobs / Trabajos",
      "vocabulary": [
        { "en": "Teacher", "es": "Profesor" },
        { "en": "Doctor", "es": "Médico" },
        { "en": "Nurse", "es": "Enfermero" },
        { "en": "Driver", "es": "Conductor" },
