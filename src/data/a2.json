        { "en": "Farmer", "es": "Granjero" },
        { "en": "Police officer", "es": "Policía" },
        { "en": "Salesperson", "es": "Vendedor" },
        { "en": "Manager", "es": "Gerente" }
      ],
      "grammar": {
        "rule": "Questions with 'do/does'",
        "explanation_es": "Para preguntar en presente simple usamos do/does: 'What do you do?', 'Where does she work?'.",
        "examples": ["What do you do?", "Where does she work?", "Do you like your job?", "He works as a teacher.", "Does he drive a bus?"]
      },
      "games": ["word_match", "fill_blank", "flashcard", "speaking_mirror"]
    },
    {
      "id": "u4",
      "title": "Simple Past / Pasado simple",
      "vocabulary": [
        { "en": "Went", "es": "Fui / Fue" },
        { "en": "Saw", "es": "Vi / Vio" },
        { "en": "Ate", "es": "Comí / Comió" },
        { "en": "Played", "es": "Jugué / Jugó" },
        { "en": "Watched", "es": "Miré / Miró" },
        { "en": "Visited", "es": "Visité" },
        { "en": "Bought", "es": "Compré" },
        { "en": "Made", "es": "Hice" },
        { "en": "Took", "es": "Tomé" },
        { "en": "Came", "es": "Vine" },
        { "en": "Last night", "es": "Anoche" },
        { "en": "Yesterday", "es": "Ayer" }
      ],
      "grammar": {
        "rule": "Past Simple – Regular & Irregular",
        "explanation_es": "Los verbos regulares añaden -ed (played). Los irregulares cambian (go → went, eat → ate).",
        "examples": ["Yesterday I went to the park.", "She ate pizza last night.", "We played football.", "They watched a movie.", "He bought a new car."]
      },
      "sentences": [
        "Yesterday I went to the park.",
        "She ate pizza last night.",
        "We played football together.",
        "They watched a good movie."
      ],
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo", "speaking_mirror"]
    },
    {
      "id": "u5",
      "title": "Describing People / Describir personas",
      "vocabulary": [
        { "en": "Tall", "es": "Alto" },
        { "en": "Short", "es": "Bajo" },
        { "en": "Young", "es": "Joven" },
        { "en": "Old", "es": "Viejo" },
        { "en": "Kind", "es": "Amable" },
        { "en": "Funny", "es": "Gracioso" },
