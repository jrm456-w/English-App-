        { "en": "Friendly", "es": "Amigable" },
        { "en": "Shy", "es": "Tímido" },
        { "en": "Busy", "es": "Ocupado" }
      ],
      "grammar": {
        "rule": "Comparatives (-er / more)",
        "explanation_es": "Para comparar: adjetivos cortos + -er (taller), largos con 'more' (more friendly). 'than' = que.",
        "examples": ["He is taller than me.", "She is kinder than him.", "This book is more interesting.", "You are stronger than you think.", "He is younger than his sister."]
      },
      "games": ["word_match", "fill_blank", "flashcard", "speaking_mirror"]
    },
    {
