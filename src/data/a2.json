      "title": "Daily Routines / Rutinas",
      "vocabulary": [
        { "en": "Wake up", "es": "Despertarse" },
        { "en": "Get up", "es": "Levantarse" },
        { "en": "Breakfast", "es": "Desayuno" },
        { "en": "Work", "es": "Trabajar" },
        { "en": "Lunch", "es": "Almuerzo" },
        { "en": "Study", "es": "Estudiar" },
        { "en": "Sleep", "es": "Dormir" },
        { "en": "Shower", "es": "Ducharse" },
        { "en": "Dinner", "es": "Cena" },
        { "en": "Get dressed", "es": "Vestirse" },
        { "en": "Brush teeth", "es": "Cepillarse los dientes" },
        { "en": "Go home", "es": "Ir a casa" }
      ],
      "grammar": {
        "rule": "Present Simple – He/She/It (+s)",
        "explanation_es": "Con he/she/it añadimos -s al verbo: 'She works', 'He studies'.",
        "examples": ["She wakes up at seven.", "He works in an office.", "It rains in winter.", "My mother cooks dinner.", "He brushes his teeth."]
      },
      "fill": [
        { "sentence": "She ___ up at seven.", "answer": "wakes", "options": ["wake", "waking", "woke"] },
        { "sentence": "He ___ in an office.", "answer": "works", "options": ["work", "working", "worked"] }
      ],
      "games": ["word_match", "fill_blank", "flashcard", "listening_echo", "speaking_mirror"]
    },
    {
      "id": "u2",
      "title": "Food & Drinks / Comida y bebidas",
      "vocabulary": [
        { "en": "Cheese", "es": "Queso" },
        { "en": "Butter", "es": "Mantequilla" },
        { "en": "Meat", "es": "Carne" },
        { "en": "Fish", "es": "Pescado" },
        { "en": "Vegetables", "es": "Verduras" },
        { "en": "Soup", "es": "Sopa" },
        { "en": "Juice", "es": "Jugo" },
