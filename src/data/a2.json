      "grammar": {
        "rule": "Present Simple – He/She/It (+s)",
        "explanation_es": "Con he/she/it añadimos -s al verbo: 'She works', 'He studies'.",
        "examples": ["She wakes up at seven.", "He works in an office.", "It rains in winter.", "My mother cooks dinner.", "He brushes his teeth."]
      },
      "fill": [
        { "sentence": "She ___ up at seven.", "answer": "wakes", "options": ["wake", "waking", "woke"] },
        { "sentence": "He ___ in an office.", "answer": "works", "options": ["work", "working", "worked"] }
      ],
