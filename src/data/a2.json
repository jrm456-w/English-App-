      "title": "Shopping / De compras",
      "vocabulary": [
        { "en": "Price", "es": "Precio" },
        { "en": "Cheap", "es": "Barato" },
        { "en": "Expensive", "es": "Caro" },
        { "en": "Money", "es": "Dinero" },
        { "en": "Buy", "es": "Comprar" },
