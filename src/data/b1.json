      },
      "fill": [
        { "sentence": "I have ___ to Paris twice.", "answer": "been", "options": ["go", "went", "going"] },
        { "sentence": "She has ___ her passport.", "answer": "lost", "options": ["lose", "losing", "loses"] }
      ],
