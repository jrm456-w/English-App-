        { "en": "Consequence", "es": "Consecuencia" }
      ],
      "grammar": {
        "rule": "Second Conditional",
        "explanation_es": "Para situaciones hipotéticas: 'If I were rich, I would travel'. Usamos 'were' para todas las personas.",
        "examples": ["If I were rich, I would travel the world.", "If she studied more, she would pass.", "I wouldn't do that unless it was necessary.", "We would help if we could.", "Even if it rained, we would go."]
      },
      "story": {
        "text": "If I ___ more time, I would learn three languages. I ___ travel to many countries and meet new people. Unless we ___ harder, we will not improve. ___ that you practice every day, fluency is possible. As long as you stay ___ , you will succeed.",
